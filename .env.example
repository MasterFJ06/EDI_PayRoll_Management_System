APP_NAME=Employee Payroll Management System
APP_ENV=development
DEBUG=true


# --------------------------------------------------
# Database
# --------------------------------------------------

DATABASE_USER=root
DATABASE_PASSWORD=YOUR_MYSQL_PASSWORD
